{
    "manifest_version": 3,

    "name": "StudyFocus",

    "version": "1.1.0",

    "description": "Block distracting websites and stay focused while studying.",

    "permissions": [
        "storage",
        "declarativeNetRequest",
        "alarms"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_title": "StudyFocus"
    },

    "background": {
        "service_worker": "background.js"
    },

    "web_accessible_resources": [
        {
            "resources": [
                "blocked.html",
                "blocked.css",
                "blocked.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}